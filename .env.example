# ventana.ia — SYS.VENTANA
# Copiá este archivo a .env y completá.

# Obligatorio en producción. Generá uno largo.
SECRET_KEY=cambiá-esto-por-una-cadena-larga-y-secreta

# Visión (SpaceXAI / xAI). Sin esta clave el sistema sigue andando:
# se puede cargar el remito y completar las líneas a mano.
XAI_API_KEY=

# Modelo de visión. grok-4.6 entiende imagen + documento.
XAI_MODEL=grok-4.6

# Host de escucha. 0.0.0.0 permite entrar desde el celular en la red local.
HOST=0.0.0.0
PORT=5202

# Telegram — también se puede cargar desde Protocolo (admin) en la UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zona horaria de Posadas
TZ=America/Argentina/Buenos_Aires
